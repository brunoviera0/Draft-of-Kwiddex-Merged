# Frontend runtime API prefix (Vite)
# Set to https://api.kwiddex.com in Vercel production.
VITE_API_BASE=

# Server environment configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
USE_OPENAI_SCORER=true
MAX_UPLOAD_MB=15

# MySQL configuration (Cloud SQL + local fallback)
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASS=
# Optional legacy alias; DB_PASS is preferred.
DB_PASSWORD=
# Cloud Run / Cloud SQL socket mode
INSTANCE_CONNECTION_NAME=project:region:instance
# Local TCP fallback (used when INSTANCE_CONNECTION_NAME is unset)
DB_HOST=127.0.0.1
DB_PORT=3306

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Optional app base path (example: /api)
BASE_PATH=

# Optional extra CORS allow-list entries (comma-separated)
CORS_ORIGINS=
